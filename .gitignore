# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build/*
!/build/*.sh
!/build/**/*.sh

# misc
.DS_Store
*.pem
.cache/
/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
/dev.pid
/dev.log
__pycache__/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.session-secret*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sessions / tokens
/test-session-token.local
/.test-session-token.local
*.token.local
*.session.local

# local dev/test logs
/dev.pid
/dev.log
/dev-server.log
/dev-server*.log
*.err

# local debug/validation artifacts
/calendar-*.json
/calendar-*.err
/debug-*.json
/debug-*.err
/insp*.json
/shots/
/shots-report.json
/shots*.json
/fonts-local.conf
/.tmp-*
/.tmp-validation/
/steam-api-key-test.md
/timeouts.md

# temporary local scripts
/scripts/*tmp*
/scripts/debug-*
/scripts/inspect*
/scripts/shots.mjs

# browser/playwright caches
/browser-root/
/browser-root/
/.browser-root/
/.fontconfig-cache/
/.pkgs/
/.pw-browsers/
/playwright-report/
/test-results/

# linux desktop build artifacts
/desktop_version/linux/.build/
/desktop_version/linux/dist/
/desktop_version/linux/src-tauri/target/
/desktop_version/linux/src-tauri/binaries/
