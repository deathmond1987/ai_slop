# Optional: signed cookie session secret / legacy fallback / encryption key seed.
# Any 32+ char random string. If unset, the app generates and reuses
# .session-secret.local automatically, then mirrors the secret to SQLite.
SESSION_PASSWORD=

# Optional: central SQLite file path for cache, users, sessions, settings,
# preferences and app secrets. If unset, DB_SQLITE_PATH falls back to
# CACHE_SQLITE_PATH, then to ./data/steam-calendar.sqlite.
DB_SQLITE_PATH=

# Optional: 64-hex AES-256-GCM key used to encrypt stored API keys in SQLite.
# If unset, the app derives a key from SESSION_PASSWORD / session secret.
DB_ENCRYPTION_KEY=

# Optional legacy alias: SQLite cache file path. Prefer DB_SQLITE_PATH.
# If unset, the app uses ./data/steam-calendar.sqlite.
CACHE_SQLITE_PATH=

# Optional: RAWG.io API key used as fallback for release dates not present in Steam.
RAWG_API_KEY=

# Optional: absolute base URL of the app (scheme://host[:port]) for Steam
# OpenID return_to/realm. If unset, derived from request Host /
# X-Forwarded-Host / X-Forwarded-Proto headers.
AUTH_BASE_URL=

# Optional: override Secure session cookie flag. Unset means auto:
# AUTH_BASE_URL/X-Forwarded-Proto https => true, otherwise false.
COOKIE_SECURE=

# Note: Steam Web API key is per-user and stored in the session after
# login via /settings. Do NOT put a personal key here.
