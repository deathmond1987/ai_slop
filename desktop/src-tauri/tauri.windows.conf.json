{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Calendar",
  "version": "1.0.9",
  "identifier": "com.steamcalendar.desktop",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": {
      "cwd": "../",
      "script": "node scripts/build-sidecar.mjs",
      "wait": true
    },
    "beforeBuildCommand": {
      "cwd": "../",
      "script": "node scripts/build-sidecar.mjs"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Steam Calendar",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/steam-calendar-node"
    ],
    "resources": {
      "../.build/app": "app"
    },
    "category": "Productivity",
    "shortDescription": "Steam Calendar desktop app",
    "longDescription": "Windows desktop wrapper for Steam Calendar with a local Next.js sidecar.",
    "icon": [
      "icons/icon-16x16.png",
      "icons/icon-32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
